<?xml version="1.0" encoding="UTF-8" ?>
<!--
    NitroWebExpress Configuration
    ==============================
    MEARVK LLC — National Finance Engine v2811.1
    Author: Max Rupplin

    All ports listed here are the authoritative reference for NWE services.
    Port privilege for MODULE_LOADER_DAEMON is established externally by the
    national port-aware program and its database.  All other ports are bound
    locally on startup.

    Admin credentials below are for the initial administrator.  Change the
    password before first production deployment.  The admin account governs:
      - database configuration
      - server document management
      - module installation / unload authority
      - inclusion decisions (enabling / disabling servers at startup)
-->
<nwe-config>

    <!-- ═══════════════════════════════════════════════════════════════════
         INITIAL ADMINISTRATOR
         Username and password are loaded by NweConfig at startup.
         The admin may log in to any TCP service that accepts admin auth
         (ModuleInstallationService, ModuleLoaderDaemon) using these credentials.
    ════════════════════════════════════════════════════════════════════ -->
    <admin>
        <username>mearvk</username>
        <password>n21admin</password>
        <description>
            Initial NWE administrator.  Responsible for database configuration,
            server document management, and module authority.
            Change the password before production deployment.
        </description>
    </admin>

    <!-- ═══════════════════════════════════════════════════════════════════
         MAIN SERVER
    ════════════════════════════════════════════════════════════════════ -->
    <server id="NITRO_WEB_EXPRESS">
        <enabled>true</enabled>
        <name>NitroWebExpress</name>
        <thread>WEBEXPRESS_TELNET_PROXY_SERVER</thread>
        <host>localhost</host>
        <port>49152</port>
        <telnet-enabled>true</telnet-enabled>
        <description>Main NitroWebExpress entry point. Telnet-proxy enabled.</description>
    </server>

    <!-- ═══════════════════════════════════════════════════════════════════
         ENCRYPTION SERVERS
    ════════════════════════════════════════════════════════════════════ -->
    <server id="AES_COMPLIANT">
        <enabled>true</enabled>
        <name>AES 2.0 DSS5.0 Server</name>
        <thread>WEBEXPRESS_AES2_SERVER</thread>
        <host>localhost</host>
        <port>5512</port>
        <telnet-enabled>true</telnet-enabled>
        <description>AES 2.0 compliant sub-server. Cryptographic compliance layer.</description>
    </server>

    <server id="RSA_COMPLIANT">
        <enabled>true</enabled>
        <name>RSA Compliant Server</name>
        <thread>WEBEXPRESS_RSA_SERVER</thread>
        <host>localhost</host>
        <port>7743</port>
        <telnet-enabled>true</telnet-enabled>
        <description>RSA encryption sub-server.</description>
    </server>

    <server id="DSA_COMPLIANT">
        <enabled>true</enabled>
        <name>DSA Compliant Server</name>
        <thread>WEBEXPRESS_DSA_SERVER</thread>
        <host>localhost</host>
        <port>7744</port>
        <telnet-enabled>true</telnet-enabled>
        <description>DSA encryption sub-server.</description>
    </server>

    <!-- ═══════════════════════════════════════════════════════════════════
         BITCOIN SERVER
    ════════════════════════════════════════════════════════════════════ -->
    <server id="BITCOIN_COMPLIANT">
        <enabled>true</enabled>
        <name>Bitcoin v24.0+ Masterthread</name>
        <thread>WEBEXPRESS_BITCOIN_SERVER</thread>
        <host>localhost</host>
        <port>6682</port>
        <telnet-enabled>true</telnet-enabled>
        <description>Bitcoin lightweight trading sub-server.</description>
    </server>

    <!-- ═══════════════════════════════════════════════════════════════════
         STATUS AND UTILITY SERVERS
    ════════════════════════════════════════════════════════════════════ -->
    <server id="CONNECTION_STATUS">
        <enabled>true</enabled>
        <name>ConnectionStatusServer</name>
        <thread>ConnectionStatusServer</thread>
        <host>localhost</host>
        <port>49155</port>
        <description>Returns server status: IP, geo, uptime, memory, connection count.</description>
    </server>

    <server id="ASCII_CREATOR">
        <enabled>true</enabled>
        <name>ASCIICreatorServer</name>
        <thread>ASCIICreatorServer</thread>
        <host>localhost</host>
        <port>49177</port>
        <description>Binary ASCII signature service. Issues unique signatures per National ID.</description>
    </server>

    <!-- ═══════════════════════════════════════════════════════════════════
         MODULE SERVICES
    ════════════════════════════════════════════════════════════════════ -->
    <server id="MODULE_INSTALLATION">
        <enabled>true</enabled>
        <name>ModuleInstallationService</name>
        <thread>ModuleInstallationService</thread>
        <host>localhost</host>
        <port>49166</port>
        <description>
            Install, unload, and manage modules via authenticated TCP session.
            Requires National ID identification and admin password for privileged ops.
        </description>
    </server>

    <server id="MODULE_LOADER_DAEMON">
        <enabled>true</enabled>
        <name>ModuleLoaderDaemon</name>
        <thread>ModuleLoaderDaemon</thread>
        <host>localhost</host>
        <port>49188</port>
        <description>
            Standalone OS-installable module loader daemon.  Runs independently;
            can be installed as a systemd/launchd/Windows service.  Supports
            remote push, pull, and replication to other ModuleLoaderDaemon instances.
            Port privilege is granted by the national port-aware program and
            its external database before clients may perform write operations.
        </description>
        <port-authority>
            <!-- Token store is populated at runtime by the national port-authority
                 database.  If empty, local/trusted access is permitted without token. -->
            <tokens-required>true</tokens-required>
            <authority-db>national-port-registry</authority-db>
        </port-authority>
    </server>

    <server id="COMMUNICATOR">
        <enabled>true</enabled>
        <name>Communicator</name>
        <thread>Communicator</thread>
        <host>localhost</host>
        <port>49199</port>
        <description>
            Persistent 1-hour telnet chat server.  Supports direct messaging,
            broadcast, scheduled delivery (per recipient local timezone), and
            chat history.  MessagePoller daemon polls MySQL every 60 seconds
            for due scheduled messages and delivers them to live sessions.
            Set enabled=false to disable without recompiling.
        </description>
    </server>

    <!-- ═══════════════════════════════════════════════════════════════════
         WEATHER SERVER
    ════════════════════════════════════════════════════════════════════ -->
    <server id="WEATHER">
        <enabled>true</enabled>
        <name>WeatherServer</name>
        <thread>WeatherServer</thread>
        <host>localhost</host>
        <port>49133</port>
        <description>
            Telnet weather service. Send a city name or lat,lon; returns
            current conditions from wttr.in. Supports lang command.
        </description>
    </server>

    <!-- ═══════════════════════════════════════════════════════════════════
         BINARY HTTP SERVER
         apache-root: Apache2 document root subdirectory for stored files.
         apache-url:  Public base URL served by Apache2.
    ════════════════════════════════════════════════════════════════════ -->
    <server id="BINARY_HTTP">
        <enabled>true</enabled>
        <name>BinaryHttpServer</name>
        <thread>BinaryHttpServer</thread>
        <host>localhost</host>
        <port>49144</port>
        <description>
            Binary data → HTTP link server.  PUT: accepts length-prefixed binary,
            writes file to apache-root, returns HTTP URL.
            GET: downloads a URL, saves to apache-root, returns HTTP URL.
        </description>
    </server>
    <apache-root>/var/www/html/nwe</apache-root>
    <apache-url>http://localhost/nwe</apache-url>

    <!-- ═══════════════════════════════════════════════════════════════════
         ANTIVIRUS SCANNER
         schedule: hourly | daily | weekly | monthly | yearly
         scan-path: root directory to scan (defaults to project root)
         Requires ClamAV (clamscan) installed on the host system.
         Set enabled=false to disable without recompiling.
    ════════════════════════════════════════════════════════════════════ -->
    <server id="ANTIVIRUS">
        <enabled>true</enabled>
        <name>AntivirusScanner</name>
        <schedule>daily</schedule>
        <scan-path>.</scan-path>
        <description>
            Runs clamscan on NWE contents and file integrity check on a
            configurable schedule.  Results are printed to the system log.
            Valid schedules: hourly | daily | weekly | monthly | yearly.
        </description>
    </server>

    <!-- ═══════════════════════════════════════════════════════════════════
         HEURISTIC CLASSIFIER
    ════════════════════════════════════════════════════════════════════ -->
    <server id="HEURISTIC_CLASSIFIER">
        <enabled>true</enabled>
        <name>HeuristicClassifier</name>
        <description>
            Classifies every inbound connection across all public ports.
            Scores IP repetition, port-scan patterns, geo-location concentration,
            and payload keywords.  Threat connections (score >= 40) are dropped
            immediately at the accept loop.  Set enabled=false to disable without
            recompiling.
        </description>
    </server>

    <!-- ═══════════════════════════════════════════════════════════════════
         BASE SERVER CLASS SELECTION
         ═══════════════════════════════════════════════════════════════════
         Selects which server implementation handles inbound connections.
         Only one may be active at a time.  Set selected="true" on the
         desired class; all others must be "false".

         BaseServer             — standard server, no connection caps or
                                  weight balancing. Default.
         HardenedBaseServer     — connection caps (512), per-IP limit (10),
                                  reduced timeout (30 min), port whitelist.
                                  Premium option.
         NationalAwareHardService — weight-based request balancing, 5040 max
                                  connections, 1-per-IP, 58-min timeout,
                                  cost-aware ejection of heavy consumers.
                                  Premium option.
    ════════════════════════════════════════════════════════════════════ -->
    <server-class>
        <option id="BASE_SERVER" selected="true" premium="false">
            <class>server.base.BaseServer</class>
            <description>Standard BaseServer. No connection limits or weight balancing.</description>
        </option>
        <option id="HARDENED_BASE_SERVER" selected="false" premium="true">
            <class>server.experimental.HardenedBaseServer</class>
            <description>
                Hardened server with 512 max connections, 10 per-IP limit,
                30-minute socket timeout, port whitelist, and graceful shutdown.
            </description>
        </option>
        <option id="NATIONAL_AWARE_HARD_SERVICE" selected="false" premium="true">
            <class>server.hardened.experimental.m.NationalAwareHardService</class>
            <description>
                Weight-balanced hardened server. 5040 max connections, 1 per-IP,
                58-minute timeout. Long/heavy requests cost more weight and are
                ejected when budget is exceeded — protecting lightweight requests
                from starvation.
            </description>
        </option>
    </server-class>

    <!-- ═══════════════════════════════════════════════════════════════════
         REMOTE / EXTERNAL SERVERS  (for outbound connections)
    ════════════════════════════════════════════════════════════════════ -->
    <remote-server id="AES_REMOTE">
        <name>AES 2.0 Remote Server</name>
        <domain>mearvk.us</domain>
        <ip>45.32.31.139</ip>
        <description>Production AES remote target.</description>
    </remote-server>

    <remote-server id="BITCOIN_REMOTE">
        <name>Bitcoin v24.0+ Remote Server</name>
        <domain>mearvk.us</domain>
        <ip>45.32.31.139</ip>
        <description>Production Bitcoin remote target.</description>
    </remote-server>

    <!-- ═══════════════════════════════════════════════════════════════════
         OBJECT HASHCODE OVERRIDES
         Admins may set fixed Object IDs for well-known classes.
         These appear in the [Object ID: XXXXXXXXXX] field of system output.
         Format: <entry class="SimpleClassName">integer_value</entry>
    ════════════════════════════════════════════════════════════════════ -->
    <hashcodes>
        <entry class="NitroWebExpress">0195600860</entry>
        <entry class="MessageQueueSorter">1343441044</entry>
        <entry class="MessageQueue">0762660330</entry>
        <entry class="HeuristicClassifier">0481230099</entry>
        <entry class="ConnectionPoller">0553219871</entry>
        <entry class="Communicator">0617340022</entry>
        <entry class="BinaryHttpServer">0889912345</entry>
        <entry class="WeatherServer">0721100456</entry>
    </hashcodes>

</nwe-config>
