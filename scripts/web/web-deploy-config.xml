<?xml version="1.0" encoding="UTF-8"?>
<!--
    NitroWebExpress™ — Web Module Deployment Configuration
    Controls which servlet webapps are installed, started, and scheduled.
    Edit this file to enable/disable modules before running deploy scripts.

    NOTE: <tomcat-home> is kept in sync with configuration/nwe-config.xml
    <web-servers><tomcat><install-dir> by post-clone.sh and deploy scripts.
-->
<web-deploy>
    <tomcat-home>/opt/apache-tomcat-11.0.2</tomcat-home>
    <mysql-host>127.0.0.1</mysql-host>
    <mysql-port>3306</mysql-port>
    <mysql-user>root</mysql-user>

    <modules>
        <!-- install: deploy webapp to Tomcat -->
        <!-- start: start on deploy -->
        <!-- reboot: auto-start on system reboot (systemd/launchd/task-scheduler) -->
        <!-- cron: schedule periodic tasks (crawl, sync, etc.) -->

        <module id="brarner.m.alete">
            <enabled>true</enabled>
            <context>brarner.m.alete</context>
            <deploy-script>modules/black/presidential/Brarner.M.Alete/install/deploy-local.sh</deploy-script>
            <database>BrarnerScience</database>
            <install>true</install>
            <start>true</start>
            <reboot>true</reboot>
            <cron enabled="false"/>
        </module>

        <module id="ae6e66">
            <enabled>true</enabled>
            <context>ae6e66</context>
            <deploy-script>modules/AE6E66/servlets/deploy-local.sh</deploy-script>
            <setup-script>modules/AE6E66/servlets/setup-db.sh</setup-script>
            <database>nwe_ae6e66</database>
            <install>true</install>
            <start>true</start>
            <reboot>true</reboot>
            <cron enabled="true" schedule="0 3 1 * *" job="crawl"/>
        </module>

