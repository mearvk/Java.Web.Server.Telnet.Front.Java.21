<?xml version="1.0" encoding="UTF-8" ?>
<!--
    ═══════════════════════════════════════════════════════════════════════════════
    Ubuntu Determinant Alpha RS — Mail System Configuration
    ═══════════════════════════════════════════════════════════════════════════════

    Centralized configuration for:
      - Postfix (MTA — outbound/inbound SMTP)
      - Dovecot (IMAP/POP3 — mailbox access)
      - DNS (MX, SPF, DKIM, DMARC records)
      - Let's Encrypt (TLS certificates)
      - ClamAV (milter integration)
      - Fail2ban (brute-force protection)
      - Roundcube/Webmail (optional browser client)
      - FiduciaryServices (transfer notifications via SMTP)

    SECURITY NOTE:
      Passwords and API keys in this file must be replaced with actual values
      on the target system. Do NOT commit real credentials to version control.
      Use environment variables or secrets manager where available.

    Installer Tech ID: Max Rupplin
    Date: August 2026
    Edition: Galactic Cherry Marvell 98
    ═══════════════════════════════════════════════════════════════════════════════
-->
<mail-config version="1" edition="Galactic Cherry Marvell 98">

    <!-- ═══════════════════════════════════════════════════════════════════════
         IDENTITY — Domain and hostname
         ═══════════════════════════════════════════════════════════════════════ -->
    <identity>
        <domain>lauradei.us</domain>
        <hostname>mail.lauradei.us</hostname>
        <origin>lauradei.us</origin>
        <admin-email>mearvk@lauradei.us</admin-email>
        <postmaster>postmaster@lauradei.us</postmaster>
    </identity>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DNS — Records required for mail delivery and authentication
         ═══════════════════════════════════════════════════════════════════════ -->
    <dns>
        <provider>
            <name>Vultr DNS</name>
            <api-endpoint>https://api.vultr.com/v2/domains</api-endpoint>
            <api-key>${VULTR_API_KEY}</api-key>
            <!-- Alternative providers: Cloudflare, Route53, DigitalOcean, Namecheap -->
        </provider>

        <!-- MX Record — tells the world where to deliver mail for this domain -->
        <record type="MX">
            <name>lauradei.us</name>
            <value>mail.lauradei.us</value>
            <priority>10</priority>
            <ttl>3600</ttl>
            <note>Points inbound mail to our server. Priority 10 = primary.</note>
        </record>

        <!-- A Record — resolves mail.lauradei.us to our IP -->
        <record type="A">
            <name>mail.lauradei.us</name>
            <value>45.32.31.139</value>
            <ttl>3600</ttl>
            <note>Public IP of the mail server.</note>
        </record>

        <!-- Reverse PTR — ISP/VPS must set this. Critical for delivery reputation. -->
        <record type="PTR">
            <ip>45.32.31.139</ip>
            <value>mail.lauradei.us</value>
            <note>Set via VPS control panel. Many receivers reject mail without valid PTR.</note>
        </record>

        <!-- SPF — declares which IPs are authorized to send for this domain -->
        <record type="TXT">
            <name>lauradei.us</name>
            <value>v=spf1 ip4:45.32.31.139 mx ~all</value>
            <ttl>3600</ttl>
            <note>Authorizes our IP and MX record. ~all = soft fail others.</note>
        </record>

        <!-- DKIM — cryptographic signature for outbound mail -->
        <record type="TXT">
            <name>default._domainkey.lauradei.us</name>
            <value>v=DKIM1; k=rsa; p=${DKIM_PUBLIC_KEY}</value>
            <ttl>3600</ttl>
            <note>DKIM selector "default". Public key generated by opendkim-genkey.</note>
        </record>

        <!-- DMARC — policy for handling SPF/DKIM failures -->
        <record type="TXT">
            <name>_dmarc.lauradei.us</name>
            <value>v=DMARC1; p=quarantine; rua=mailto:dmarc-reports@lauradei.us; pct=100; adkim=r; aspf=r</value>
            <ttl>3600</ttl>
            <note>Quarantine messages failing SPF+DKIM. Reports sent to dmarc-reports@.</note>
        </record>

        <!-- SRV Records — auto-discovery for email clients (Thunderbird, iOS, Android) -->
        <record type="SRV">
            <name>_imaps._tcp.lauradei.us</name>
            <value>0 1 993 mail.lauradei.us</value>
            <ttl>3600</ttl>
            <note>IMAP over TLS auto-discovery.</note>
        </record>
        <record type="SRV">
            <name>_submission._tcp.lauradei.us</name>
            <value>0 1 587 mail.lauradei.us</value>
            <ttl>3600</ttl>
            <note>SMTP submission auto-discovery.</note>
        </record>

        <!-- Autoconfig — Mozilla Thunderbird automatic configuration -->
        <record type="CNAME">
            <name>autoconfig.lauradei.us</name>
            <value>mail.lauradei.us</value>
            <ttl>3600</ttl>
            <note>Thunderbird checks autoconfig.domain/mail/config-v1.1.xml</note>
        </record>
    </dns>

    <!-- ═══════════════════════════════════════════════════════════════════════
         POSTFIX — Mail Transfer Agent
         ═══════════════════════════════════════════════════════════════════════ -->
    <postfix>
        <config-dir>/etc/postfix</config-dir>
        <main-cf>/etc/postfix/main.cf</main-cf>
        <master-cf>/etc/postfix/master.cf</master-cf>
        <service>postfix</service>

        <ports>
            <smtp>25</smtp>
            <submission>587</submission>
            <smtps>465</smtps>
        </ports>

        <tls>
            <cert>/etc/letsencrypt/live/lauradei.us/fullchain.pem</cert>
            <key>/etc/letsencrypt/live/lauradei.us/privkey.pem</key>
            <security-level-inbound>may</security-level-inbound>
            <security-level-outbound>may</security-level-outbound>
            <min-protocol>TLSv1.2</min-protocol>
            <ciphers>ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:!aNULL:!MD5:!RC4</ciphers>
        </tls>

        <sasl>
            <type>dovecot</type>
            <path>private/auth</path>
            <security-options>noanonymous</security-options>
        </sasl>

        <!-- NAT/Home Internet: uncomment relayhost if ISP blocks port 25 outbound -->
        <relay>
            <enabled>false</enabled>
            <host>[smtp.isp.com]</host>
            <port>587</port>
            <username>${RELAY_SMTP_USER}</username>
            <password>${RELAY_SMTP_PASS}</password>
            <password-map>/etc/postfix/sasl_passwd</password-map>
            <note>Enable if ISP blocks outbound port 25. Most residential ISPs do.</note>
        </relay>

        <restrictions>
            <helo-required>true</helo-required>
            <rbl>zen.spamhaus.org</rbl>
            <rbl>bl.spamcop.net</rbl>
            <rate-limit>50/hour per client</rate-limit>
            <message-size-limit>52428800</message-size-limit>
        </restrictions>

        <milter>
            <!-- ClamAV milter for inbound mail scanning -->
            <clamav>
                <enabled>true</enabled>
                <socket>inet:7357@localhost</socket>
                <action-on-failure>accept</action-on-failure>
            </clamav>
            <!-- OpenDKIM milter for signing outbound mail -->
            <opendkim>
                <enabled>true</enabled>
                <socket>inet:8891@localhost</socket>
                <selector>default</selector>
                <key-file>/etc/opendkim/keys/lauradei.us/default.private</key-file>
            </opendkim>
        </milter>
    </postfix>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DOVECOT — IMAP/POP3 Server
         ═══════════════════════════════════════════════════════════════════════ -->
    <dovecot>
        <config-dir>/etc/dovecot</config-dir>
        <main-conf>/etc/dovecot/dovecot.conf</main-conf>
        <conf-d>/etc/dovecot/conf.d</conf-d>
        <service>dovecot</service>

        <ports>
            <imap>143</imap>
            <imaps>993</imaps>
            <pop3>110</pop3>
            <pop3s>995</pop3s>
        </ports>

        <tls>
            <required>true</required>
            <cert>/etc/letsencrypt/live/lauradei.us/fullchain.pem</cert>
            <key>/etc/letsencrypt/live/lauradei.us/privkey.pem</key>
            <min-protocol>TLSv1.2</min-protocol>
            <cipher-list>ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:!aNULL:!MD5:!RC4</cipher-list>
            <prefer-server-ciphers>true</prefer-server-ciphers>
        </tls>

        <mail>
            <location>maildir:~/Maildir</location>
            <privileged-group>mail</privileged-group>
            <max-userip-connections>20</max-userip-connections>
        </mail>

        <auth>
            <mechanisms>plain login</mechanisms>
            <disable-plaintext>true</disable-plaintext>
            <failure-delay>2</failure-delay>
            <source>system</source>
            <!-- Postfix SASL socket -->
            <sasl-socket>/var/spool/postfix/private/auth</sasl-socket>
            <sasl-mode>0660</sasl-mode>
            <sasl-user>postfix</sasl-user>
            <sasl-group>postfix</sasl-group>
        </auth>

        <lmtp>
            <!-- Postfix → Dovecot delivery -->
            <socket>/var/spool/postfix/private/dovecot-lmtp</socket>
            <mode>0600</mode>
            <user>postfix</user>
            <group>postfix</group>
        </lmtp>

        <logging>
            <path>syslog</path>
            <facility>mail</facility>
            <auth-verbose>false</auth-verbose>
            <mail-debug>false</mail-debug>
        </logging>
    </dovecot>

    <!-- ═══════════════════════════════════════════════════════════════════════
         TLS CERTIFICATES — Let's Encrypt
         ═══════════════════════════════════════════════════════════════════════ -->
    <certificates>
        <provider>Let's Encrypt</provider>
        <tool>certbot</tool>
        <cert-dir>/etc/letsencrypt/live/lauradei.us</cert-dir>
        <fullchain>/etc/letsencrypt/live/lauradei.us/fullchain.pem</fullchain>
        <privkey>/etc/letsencrypt/live/lauradei.us/privkey.pem</privkey>
        <chain>/etc/letsencrypt/live/lauradei.us/chain.pem</chain>
        <auto-renew>true</auto-renew>
        <renew-hook>systemctl reload postfix dovecot</renew-hook>
        <renew-command>certbot renew --quiet --deploy-hook "systemctl reload postfix dovecot"</renew-command>
        <domains>
            <domain>lauradei.us</domain>
            <domain>mail.lauradei.us</domain>
        </domains>
    </certificates>

    <!-- ═══════════════════════════════════════════════════════════════════════
         DKIM — DomainKeys Identified Mail (OpenDKIM)
         ═══════════════════════════════════════════════════════════════════════ -->
    <dkim>
        <tool>opendkim</tool>
        <service>opendkim</service>
        <config>/etc/opendkim.conf</config>
        <selector>default</selector>
        <key-dir>/etc/opendkim/keys/lauradei.us</key-dir>
        <private-key>/etc/opendkim/keys/lauradei.us/default.private</private-key>
        <public-key>/etc/opendkim/keys/lauradei.us/default.txt</public-key>
        <key-bits>2048</key-bits>
        <signing-table>/etc/opendkim/signing.table</signing-table>
        <key-table>/etc/opendkim/key.table</key-table>
        <socket>inet:8891@localhost</socket>
        <generate-command>opendkim-genkey -s default -d lauradei.us -b 2048 -D /etc/opendkim/keys/lauradei.us/</generate-command>
    </dkim>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CLAMAV — Milter Integration (Inbound Mail Scanning)
         ═══════════════════════════════════════════════════════════════════════ -->
    <clamav>
        <service>clamav-milter</service>
        <config>/etc/clamav/clamav-milter.conf</config>
        <socket>inet:7357@localhost</socket>
        <action-on-infected>Reject</action-on-infected>
        <action-on-failure>Accept</action-on-failure>
        <scan-on-inbound>true</scan-on-inbound>
        <scan-on-outbound>false</scan-on-outbound>
        <log>/var/log/clamav/clamav-milter.log</log>
    </clamav>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FAIL2BAN — Brute-Force Protection
         ═══════════════════════════════════════════════════════════════════════ -->
    <fail2ban>
        <service>fail2ban</service>
        <config-dir>/etc/fail2ban</config-dir>

        <jail name="postfix">
            <enabled>true</enabled>
            <filter>postfix</filter>
            <log-path>/var/log/mail.log</log-path>
            <max-retry>5</max-retry>
            <ban-time>3600</ban-time>
            <find-time>600</find-time>
        </jail>

        <jail name="postfix-sasl">
            <enabled>true</enabled>
            <filter>postfix-sasl</filter>
            <log-path>/var/log/mail.log</log-path>
            <max-retry>3</max-retry>
            <ban-time>7200</ban-time>
            <find-time>600</find-time>
        </jail>

        <jail name="dovecot">
            <enabled>true</enabled>
            <filter>dovecot</filter>
            <log-path>/var/log/mail.log</log-path>
            <max-retry>5</max-retry>
            <ban-time>3600</ban-time>
            <find-time>600</find-time>
        </jail>
    </fail2ban>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FIREWALL — UFW Rules for Mail Ports
         ═══════════════════════════════════════════════════════════════════════ -->
    <firewall>
        <tool>ufw</tool>
        <rules>
            <rule action="allow" port="25" protocol="tcp" comment="SMTP relay"/>
            <rule action="allow" port="465" protocol="tcp" comment="SMTPS implicit TLS"/>
            <rule action="allow" port="587" protocol="tcp" comment="SMTP submission STARTTLS"/>
            <rule action="allow" port="143" protocol="tcp" comment="IMAP STARTTLS"/>
            <rule action="allow" port="993" protocol="tcp" comment="IMAPS implicit TLS"/>
            <rule action="allow" port="110" protocol="tcp" comment="POP3 STARTTLS"/>
            <rule action="allow" port="995" protocol="tcp" comment="POP3S implicit TLS"/>
        </rules>
    </firewall>

    <!-- ═══════════════════════════════════════════════════════════════════════
         USER ACCOUNTS — Mail accounts mapped to system users
         ═══════════════════════════════════════════════════════════════════════ -->
    <accounts>
        <account uid="1000">
            <username>mearvk</username>
            <email>mearvk@lauradei.us</email>
            <maildir>/home/mearvk/Maildir</maildir>
            <class>Genius (5)</class>
            <password-hash>system</password-hash>
        </account>
        <account uid="1001">
            <username>admin</username>
            <email>admin@lauradei.us</email>
            <maildir>/home/admin/Maildir</maildir>
            <class>Trusted (4)</class>
            <password-hash>system</password-hash>
        </account>
        <account uid="1002">
            <username>truth</username>
            <email>truth@lauradei.us</email>
            <maildir>/home/truth/Maildir</maildir>
            <class>Genius (5)</class>
            <password-hash>system</password-hash>
        </account>
        <!-- password-hash=system means Dovecot authenticates via PAM/system passwd -->
    </accounts>

    <!-- ═══════════════════════════════════════════════════════════════════════
         WEBMAIL — Roundcube (Optional browser-based client)
         ═══════════════════════════════════════════════════════════════════════ -->
    <webmail>
        <enabled>false</enabled>
        <application>Roundcube</application>
        <version>1.6.6</version>
        <context>/webmail</context>
        <imap-host>127.0.0.1</imap-host>
        <imap-port>143</imap-port>
        <smtp-host>127.0.0.1</smtp-host>
        <smtp-port>587</smtp-port>
        <database>
            <type>mysql</type>
            <host>127.0.0.1</host>
            <port>3306</port>
            <name>roundcubemail</name>
            <user>roundcube</user>
            <password>${ROUNDCUBE_DB_PASS}</password>
        </database>
        <note>Alternative to Roundcube: NWE Tomcat JSP webmail via /brarner.m.alete/mail.jsp</note>
    </webmail>

    <!-- ═══════════════════════════════════════════════════════════════════════
         FIDUCIARY INTEGRATION — Transfer notification emails
         ═══════════════════════════════════════════════════════════════════════ -->
    <fiduciary-integration>
        <smtp-host>127.0.0.1</smtp-host>
        <smtp-port>587</smtp-port>
        <smtp-tls>starttls</smtp-tls>
        <from>fiduciary@lauradei.us</from>
        <auth-user>mearvk</auth-user>
        <auth-pass>${FIDUCIARY_SMTP_PASS}</auth-pass>

        <notifications>
            <transfer-confirmed to="mearvk@lauradei.us">true</transfer-confirmed>
            <fiduciary-hold-broken to="mearvk@lauradei.us">true</fiduciary-hold-broken>
            <daily-yield-report to="mearvk@lauradei.us">true</daily-yield-report>
            <ach-settlement to="mearvk@lauradei.us">true</ach-settlement>
            <tls-cert-expiry-warning to="admin@lauradei.us" days-before="30">true</tls-cert-expiry-warning>
        </notifications>
    </fiduciary-integration>

    <!-- ═══════════════════════════════════════════════════════════════════════
         MONITORING — Log analysis and alerting
         ═══════════════════════════════════════════════════════════════════════ -->
    <monitoring>
        <mail-log>/var/log/mail.log</mail-log>
        <mail-err>/var/log/mail.err</mail-err>
        <auth-log>/var/log/auth.log</auth-log>

        <alerts>
            <queue-size-warn>50</queue-size-warn>
            <queue-size-critical>200</queue-size-critical>
            <auth-failures-per-hour-warn>20</auth-failures-per-hour-warn>
            <disk-usage-warn-pct>80</disk-usage-warn-pct>
        </alerts>

        <!-- Dave AI integration: monitors mail health -->
        <dave-integration>
            <enabled>true</enabled>
            <check-interval>300</check-interval>
            <metrics>queue-size, auth-failures, delivery-rate, bounce-rate, tls-ratio</metrics>
        </dave-integration>
    </monitoring>

    <!-- ═══════════════════════════════════════════════════════════════════════
         NAT / HOME INTERNET STRATEGY
         ═══════════════════════════════════════════════════════════════════════ -->
    <nat-strategy>
        <description>
            On home internet, outbound ports 587/465 are open (send mail works).
            Inbound port 25 is blocked by NAT and often by ISP.
            Inbound ports 993/143 are blocked by NAT.
            Strategy: use relay for outbound, NWE Gateway for inbound.
        </description>

        <outbound>
            <port-587>open</port-587>
            <port-465>open</port-465>
            <port-25>often-isp-blocked</port-25>
            <solution>Use relayhost via port 587 to ISP or smarthost</solution>
        </outbound>

        <inbound>
            <port-25>blocked-by-nat</port-25>
            <port-993>blocked-by-nat</port-993>
            <port-143>blocked-by-nat</port-143>
            <solution-1>UPnP port forwarding (unreliable)</solution-1>
            <solution-2>NWE Gateway relay (reverse tunnel to public server)</solution-2>
            <solution-3>Webmail via Tomcat (no inbound port needed)</solution-3>
            <solution-4>Fetch mail via IMAP from relay server (outbound poll)</solution-4>
        </inbound>

        <relay-server>
            <host>relay.mearvk.us</host>
            <port>443</port>
            <protocol>TLS reverse tunnel</protocol>
            <note>Same relay used by NWE Gateway for web traffic</note>
        </relay-server>
    </nat-strategy>

    <!-- ═══════════════════════════════════════════════════════════════════════
         INSTALLER
         ═══════════════════════════════════════════════════════════════════════ -->
    <installer>
        <tech-id>Max Rupplin</tech-id>
        <company>MEARVK LLC</company>
        <edition>Galactic Cherry Marvell 98</edition>
        <installed>2026-08-03</installed>
        <postfix-script>tools/postfix/install_postfix.sh</postfix-script>
        <dovecot-script>tools/dovecot/install_dovecot.sh</dovecot-script>
    </installer>

</mail-config>
