<?xml version="1.0" encoding="UTF-8"?>
<ae6e66-config>
    <module>
        <name>AE6E66</name>
        <description>House of Lords + House of Commons Contact and Portrait Module</description>
        <version>1.1</version>
        <author>Max Rupplin - MEARVK LLC</author>
        <color>Emerald Green</color>
        <trust>9.5/10</trust>
    </module>

    <crawl>
        <members-url>https://members.parliament.uk/members/Lords</members-url>
        <commons-url>https://members.parliament.uk/members/Commons</commons-url>
        <hoc-enquiries-url>https://www.parliament.uk/mps-lords-and-offices/offices/commons/house-of-commons-enquiries-service/contact-us/</hoc-enquiries-url>
        <portrait-url-template>https://members.parliament.uk/member/{id}/portrait</portrait-url-template>
        <contact-url-template>https://members.parliament.uk/member/{id}/contact</contact-url-template>
        <career-url-template>https://members.parliament.uk/member/{id}/career</career-url-template>
        <id-range-start>0</id-range-start>
        <id-range-end>999</id-range-end>
        <portraits-dir>portraits</portraits-dir>
        <contacts-file>contacts.csv</contacts-file>
        <personal-dir>personal</personal-dir>
        <!-- Skip crawl if .last-crawl < 30 days. Re-crawl on new election season. -->
        <last-crawl-file>configuration/.last-crawl</last-crawl-file>
        <skip-days>30</skip-days>
        <parliament-session></parliament-session>
    </crawl>

    <messaging>
        <stationary-dir>marrister</stationary-dir>
        <sent-dir>sent</sent-dir>
        <hash-algorithm>SHA-256</hash-algorithm>
        <success-log-suffix>.success.log</success-log-suffix>
        <failure-log-suffix>.failure.log</failure-log-suffix>
    </messaging>

    <email>
        <server-id>mail.lauradei.us</server-id>
        <smtp-host>localhost</smtp-host>
        <smtp-port>25</smtp-port>
        <from-address>contact@lauradei.us</from-address>
        <from-name>MEARVK LLC</from-name>
        <domain>lauradei.us</domain>
        <static-ip>45.32.31.139</static-ip>
        <dkim-selector>ae6e66</dkim-selector>
        <install-target>Japanese VPS (chance/luck)</install-target>
        <require-postfix>true</require-postfix>
        <rate-limit-seconds>2</rate-limit-seconds>
    </email>

    <cron>
        <registered>true</registered>
        <job-name>AE6E66-Crawl</job-name>
        <schedule>0 3 1 * *</schedule>
        <noble-registry>true</noble-registry>
    </cron>

    <integrity>
        <tracked>true</tracked>
        <tech-id>Gifted Install Tech ID</tech-id>
        <restore-on-fail>true</restore-on-fail>
    </integrity>
</ae6e66-config>
