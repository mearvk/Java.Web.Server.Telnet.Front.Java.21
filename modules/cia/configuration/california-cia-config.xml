<?xml version="1.0" encoding="UTF-8" ?>
<california-cia-config>
    <server>
        <port>49211</port>
        <host>localhost</host>
        <name>CaliforniaCIA™</name>
        <masquerade-aware>true</masquerade-aware>
    </server>
    <database>
        <name>nwe_california_cia</name>
        <host>127.0.0.1</host>
        <port>3306</port>
    </database>
    <installer-id-tech>
        <enabled>true</enabled>
        <required-for>intelligence_reports,foia_requests</required-for>
    </installer-id-tech>
    <ai-module>
        <enabled>true</enabled>
        <inference-port>20000</inference-port>
        <model>distilbert</model>
    </ai-module>
    <cia-connector>
        <main-url>https://www.cia.gov/</main-url>
        <report-url>https://www.cia.gov/report-information/</report-url>
        <foia-url>https://www.cia.gov/readingroom/</foia-url>
        <careers-url>https://www.cia.gov/careers/</careers-url>
        <categories>
            <category id="counterintelligence">Counterintelligence</category>
            <category id="terrorism">Terrorism</category>
            <category id="espionage">Espionage</category>
            <category id="cyber-threats">Cyber Threats</category>
            <category id="weapons-proliferation">Weapons Proliferation</category>
            <category id="foreign-intelligence">Foreign Intelligence Activity</category>
            <category id="corruption">Government Corruption</category>
            <category id="other">Other</category>
        </categories>
    </cia-connector>
</california-cia-config>
