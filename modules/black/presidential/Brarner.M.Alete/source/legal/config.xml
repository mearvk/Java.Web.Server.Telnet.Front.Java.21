<?xml version="1.0" encoding="UTF-8"?>
<!--
    BMA Legal Module Configuration
    Module: legal
    Port Range: 18500-18507
    Belt Requirement: Green Belt or above
    DIGTIK: SecurityHeadersFilter, PreparedStatement, InputSanitizer, Installer ID Tech™
    Rating: 9.5/10
-->
<module-config module="legal" port-start="18500" port-end="18507">
    <!-- Case Law — CourtListener bulk opinions, dockets, citations -->
    <instance name="caselaw" port="18500" active="true" status="receiving"
              data-dir="data/legal/case-law" format="csv" />

    <!-- US Code — GovInfo statutory law (54 titles) -->
    <instance name="uscode" port="18501" active="true" status="receiving"
              data-dir="data/legal/us-code" format="csv" />

    <!-- Public Laws — Enacted legislation by Congress -->
    <instance name="publiclaws" port="18502" active="true" status="receiving"
              data-dir="data/legal/public-laws" format="csv" />

    <!-- Precedent — Landmark SCOTUS cases -->
    <instance name="precedent" port="18503" active="true" status="receiving"
              data-dir="data/legal/precedent" format="csv" />

    <!-- Statutes at Large — Historical statutes -->
    <instance name="statutes" port="18504" active="true" status="receiving"
              data-dir="data/legal/statutes-at-large" format="csv" />

    <!-- CFR — Code of Federal Regulations -->
    <instance name="cfr" port="18505" active="true" status="receiving"
              data-dir="data/legal/cfr" format="csv" />

    <!-- Counts — Law statistics and totals -->
    <instance name="counts" port="18506" active="true" status="receiving"
              data-dir="data/legal/counts" format="csv" />

    <!-- Citations — Who cites whom -->
    <instance name="citations" port="18507" active="true" status="receiving"
              data-dir="data/legal/case-law" format="csv" />
</module-config>
