<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <display-name>Brarner.M.Alete</display-name>

    <!-- Enable multipart file upload for JSP pages -->
    <servlet>
        <servlet-name>jsp</servlet-name>
        <servlet-class>org.apache.jasper.servlet.JspServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>10485760</max-request-size>
            <file-size-threshold>0</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>jsp</servlet-name>
        <url-pattern>*.jsp</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <servlet>
        <servlet-name>AdminLoginServlet</servlet-name>
        <servlet-class>com.mearvk.servlet.AdminLoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLoginServlet</servlet-name>
        <url-pattern>/admin/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminLogoutServlet</servlet-name>
        <servlet-class>com.mearvk.servlet.AdminLogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminLogoutServlet</servlet-name>
        <url-pattern>/admin/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DocumentServlet</servlet-name>
        <servlet-class>com.mearvk.servlet.DocumentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DocumentServlet</servlet-name>
        <url-pattern>/admin/documents</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>StatusApiServlet</servlet-name>
        <servlet-class>com.mearvk.servlet.StatusApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StatusApiServlet</servlet-name>
        <url-pattern>/api/status</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SpeciesApiServlet</servlet-name>
        <servlet-class>com.mearvk.servlet.SpeciesApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SpeciesApiServlet</servlet-name>
        <url-pattern>/api/species</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PostalApiServlet</servlet-name>
        <servlet-class>com.mearvk.servlet.PostalApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PostalApiServlet</servlet-name>
        <url-pattern>/api/postal</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ArtApiServlet</servlet-name>
        <servlet-class>com.mearvk.servlet.ArtApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ArtApiServlet</servlet-name>
        <url-pattern>/api/art</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ScienceApiServlet</servlet-name>
        <servlet-class>com.mearvk.servlet.ScienceApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ScienceApiServlet</servlet-name>
        <url-pattern>/api/science</url-pattern>
    </servlet-mapping>

    <mime-mapping>
        <extension>xhtml</extension>
        <mime-type>text/html</mime-type>
    </mime-mapping>

    <!-- Security: protect WEB-INF and admin area -->
    <security-constraint>
        <web-resource-collection>
            <web-resource-name>Protected</web-resource-name>
            <url-pattern>/WEB-INF/*</url-pattern>
        </web-resource-collection>
        <auth-constraint/>
    </security-constraint>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config><http-only>true</http-only></cookie-config>
    </session-config>

    <error-page><error-code>404</error-code><location>/index.jsp</location></error-page>

    <resource-ref>
        <res-ref-name>jdbc/BrarnerDB</res-ref-name>
        <res-type>javax.sql.DataSource</res-type>
        <res-auth>Container</res-auth>
    </resource-ref>
</web-app>
