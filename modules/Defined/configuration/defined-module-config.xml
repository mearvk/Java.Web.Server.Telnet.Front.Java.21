    <!-- Ports that remain open (not UFW-cycled) -->
    <persistent-ports>
      <port number="20" direction="out"/>
      <port number="21" direction="out"/>
      <port number="25" direction="out"/>
      <port number="80" direction="out"/>
      <port number="3306" direction="local"/>
      <port number="8080" direction="in"/>
      <port number="49220" direction="in"/>
      <port number="49221" direction="in"/>
