  <!-- BACKEND CONNECTION HOURS                                               -->
  <!-- Accept direct connections and close them outside of these hours.        -->
  <!-- Web server may access normal operations separately regardless.         -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <backend-connection-hours>
    <enabled>true</enabled>
    <timezone>America/New_York</timezone>
    <accept-hours>
      <!-- Backend telnet port 49221 accepts direct connections during these hours -->
      <window start="06:00" end="23:00" days="MON,TUE,WED,THU,FRI"/>
      <window start="08:00" end="20:00" days="SAT,SUN"/>
    </accept-hours>
    <outside-hours-behavior>reject</outside-hours-behavior>
    <outside-hours-message>Defined™ backend is closed outside operating hours. Try again during business hours EST.</outside-hours-message>
    <!-- Web server (port 8080 /defined) operates independently, 24/7 -->
    <web-server-independent>true</web-server-independent>
    <web-server-port>8080</web-server-port>
    <web-server-always-accessible>true</web-server-always-accessible>
    <!-- AI server (port 49220) operates independently for scheduled scans -->
    <ai-server-independent>true</ai-server-independent>
    <ai-server-port>49220</ai-server-port>
    <ai-server-always-accessible>true</ai-server-always-accessible>
  </backend-connection-hours>

