      <port number="443" direction="out" rule="allow"/>
      <port number="465" direction="out" rule="allow"/>
      <port number="587" direction="out" rule="allow"/>
      <port number="993" direction="out" rule="allow"/>
      <port number="990" direction="out" rule="allow"/>
