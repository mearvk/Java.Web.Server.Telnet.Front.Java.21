  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- NTSB COMMUNICATION CONFIG                                              -->
  <!-- Second option on chat window for direct NTSB communication             -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <ntsb-communication>
    <url>www.ntsb.gov</url>
    <port>80</port>
    <protocol>HTTP</protocol>
    <enabled>true</enabled>
  </ntsb-communication>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- MYSQL CONNECTION CONFIG                                                -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <mysql>
    <host>localhost</host>
    <port>3306</port>
    <database>defined_dark_gray</database>
    <username>nwe_defined</username>
    <password-env>DEFINED_MYSQL_ADMIN_PASS</password-env>
    <connection-pool-size>5</connection-pool-size>
    <auto-reconnect>true</auto-reconnect>
    <timezone>America/New_York</timezone>
  </mysql>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- RECEDING TEMPERS MODEL CONFIG                                          -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <receding-tempers>
    <model>harmonic-decay</model>
    <initial-temper-index>1.0</initial-temper-index>
    <decay-rate>0.05</decay-rate>
    <harmonic-grease-default>0.5</harmonic-grease-default>
    <data-directory>data/receding-tempers/</data-directory>
  </receding-tempers>

  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <!-- KEYWORDS DURATION MANAGEMENT                                           -->
  <!-- ═══════════════════════════════════════════════════════════════════════ -->
  <keywords>
    <default-duration-days>30</default-duration-days>
    <max-duration-days>365</max-duration-days>
    <auto-deactivate>true</auto-deactivate>
    <data-directory>data/keywords/</data-directory>
  </keywords>

