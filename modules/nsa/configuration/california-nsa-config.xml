<?xml version="1.0" encoding="UTF-8" ?>
<california-nsa-config>
    <server>
        <port>49212</port>
        <host>localhost</host>
        <name>CaliforniaNSA™</name>
        <masquerade-aware>true</masquerade-aware>
    </server>
    <database>
        <name>nwe_california_nsa</name>
        <host>127.0.0.1</host>
        <port>3306</port>
    </database>
    <installer-id-tech>
        <enabled>true</enabled>
        <required-for>cyber_reports,advisories</required-for>
    </installer-id-tech>
    <ai-module>
        <enabled>true</enabled>
        <inference-port>20000</inference-port>
        <model>distilbert</model>
    </ai-module>
    <nsa-connector>
        <main-url>https://www.nsa.gov/</main-url>
        <cybersecurity-url>https://www.nsa.gov/Cybersecurity/</cybersecurity-url>
        <report-vulnerability-url>https://www.nsa.gov/About/Cryptologic-Heritage/Historical-Figures-Posters/Report-a-Vulnerability/</report-vulnerability-url>
        <cisa-url>https://www.cisa.gov/report</cisa-url>
        <categories>
            <category id="vulnerability">Vulnerability Disclosure</category>
            <category id="malware">Malware / Ransomware</category>
            <category id="intrusion">Network Intrusion</category>
            <category id="phishing">Phishing / Social Engineering</category>
            <category id="insider-threat">Insider Threat</category>
            <category id="data-breach">Data Breach</category>
            <category id="critical-infrastructure">Critical Infrastructure</category>
            <category id="signals">Signals Intelligence</category>
            <category id="other">Other</category>
        </categories>
    </nsa-connector>
</california-nsa-config>
