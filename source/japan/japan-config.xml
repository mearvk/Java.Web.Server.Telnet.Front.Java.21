<?xml version="1.0" encoding="UTF-8" ?>
<!--
    JapanSignalServer Configuration
    ================================
    MEARVK LLC — NitroWebExpress™
    Author: Max Rupplin

    Japanese news sources, signals, and media configuration.
-->
<japan-config>

    <sources>
        <source id="nhk" url="https://www3.nhk.or.jp/nhkworld/" category="news" lang="ja" />
        <source id="mainichi" url="https://mainichi.jp/english/" category="news" lang="ja" />
        <source id="asahi" url="https://www.asahi.com/ajw/" category="news" lang="ja" />
        <source id="japantimes" url="https://www.japantimes.co.jp" category="news" lang="en" />
        <source id="nikkei" url="https://asia.nikkei.com" category="finance" lang="en" />
        <source id="kyodo" url="https://english.kyodonews.net" category="news" lang="en" />
        <source id="tokyostock" url="https://www.jpx.co.jp/english/" category="finance" lang="en" />
        <source id="jma" url="https://www.jma.go.jp/jma/indexe.html" category="weather" lang="en" />
    </sources>

    <signals>
        <signal id="nikkei225" url="https://asia.nikkei.com/Markets" type="market" />
        <signal id="jpyusd" url="https://www.boj.or.jp/en/" type="currency" />
        <signal id="earthquake" url="https://www.jma.go.jp/bosai/map.html" type="seismic" />
    </signals>

    <acceptable-media>
        <images>
            <format>jpeg</format>
            <format>png</format>
            <format>webp</format>
            <max-size-mb>25</max-size-mb>
        </images>
        <audio>
            <format>mp3</format>
            <format>wav</format>
            <format>aac</format>
            <stream-enabled>true</stream-enabled>
        </audio>
        <documents>
            <format>pdf</format>
            <format>xml</format>
            <format>json</format>
            <format>csv</format>
        </documents>
    </acceptable-media>

    <database>
        <name>nwe_japan</name>
        <host>localhost</host>
        <port>3306</port>
        <username>nwe</username>
        <password>nwe_receiver_pass</password>
    </database>

</japan-config>
