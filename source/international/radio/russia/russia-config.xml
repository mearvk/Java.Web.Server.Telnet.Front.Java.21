<?xml version="1.0" encoding="UTF-8" ?>
<!--
    RussiaSignalServer Configuration
    =================================
    MEARVK LLC — NitroWebExpress™
    Author: Max Rupplin

    Russian news sources, signals, and media configuration.
-->
<russia-config>

    <sources>
        <source id="tass" url="https://tass.com" category="news" lang="ru" />
        <source id="ria" url="https://ria.ru" category="news" lang="ru" />
        <source id="interfax" url="https://interfax.com" category="news" lang="en" />
        <source id="rbc" url="https://www.rbc.ru" category="finance" lang="ru" />
        <source id="moex" url="https://www.moex.com/en/" category="finance" lang="en" />
        <source id="kommersant" url="https://www.kommersant.ru" category="news" lang="ru" />
        <source id="vedomosti" url="https://www.vedomosti.ru" category="finance" lang="ru" />
        <source id="rt" url="https://www.rt.com" category="news" lang="en" />
    </sources>

    <signals>
        <signal id="moex_index" url="https://www.moex.com/en/index/IMOEX" type="market" />
        <signal id="rubusd" url="https://www.cbr.ru/eng/currency_base/" type="currency" />
        <signal id="brent_crude" url="https://www.moex.com/en/contract.aspx?code=BR" type="energy" />
    </signals>

    <acceptable-media>
        <images>
            <format>jpeg</format>
            <format>png</format>
            <format>webp</format>
            <max-size-mb>25</max-size-mb>
        </images>
        <audio>
            <format>mp3</format>
            <format>wav</format>
            <format>aac</format>
            <stream-enabled>true</stream-enabled>
        </audio>
        <documents>
            <format>pdf</format>
            <format>xml</format>
            <format>json</format>
            <format>csv</format>
        </documents>
    </acceptable-media>

    <database>
        <name>nwe_russia</name>
        <host>localhost</host>
        <port>3306</port>
        <username>nwe</username>
        <password>nwe_receiver_pass</password>
    </database>

    <!-- AI Integrative — Ready and Perfect -->
    <ai-integrative>
        <enabled>true</enabled>
        <ready>true</ready>
        <perfect>true</perfect>
        <shared-engine>international.radio.AIIntegrativeEngine</shared-engine>
        <country-id>russia</country-id>
        <feedback-loop>true</feedback-loop>
        <scouting>true</scouting>
        <training>true</training>
        <scoring>true</scoring>
        <verdict-housing-trust>0.95</verdict-housing-trust>
        <verdict-local-trust>0.80</verdict-local-trust>
        <verdict-internet-trust>0.40</verdict-internet-trust>
        <gain-control>true</gain-control>
        <scouting-output>source/international/radio/russia/scouting/</scouting-output>
        <review-output>source/international/radio/russia/reviews/</review-output>
        <max-scouting-mb>200</max-scouting-mb>
    </ai-integrative>

</russia-config>
