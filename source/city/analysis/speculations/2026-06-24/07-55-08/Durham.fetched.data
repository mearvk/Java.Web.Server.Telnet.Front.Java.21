<div id="SelfService-1782302045308-cartPanel" class="ss-panel-cart" data-role="panel" data-position="right" data-display="overlay" data-position-fixed="true">
	<div id="SelfService-1782302045308-cartPanelInternal" class="ss-panel-cart-internal" style="height:100%;"></div>
</div>
<script>

$("#SelfService-1782302045308-cartPanel").on("panelcreate", function() {
	$("#SelfService-1782302045308-cartPanelInternal").data("cartUrl", "/web/cart/embedded?includeButtons=true&request=" + new Date().getTime());
	$("#SelfService-1782302045308-cartPanelInternal").css("max-height", $( window ).height() -20);
	reloadShoppingCart($("#SelfService-1782302045308-cartPanelInternal"));
});
	
$("#SelfService-1782302045308-cartPanel").on("panelbeforeopen", function() {
	$("#SelfService-1782302045308-cartPanelInternal").data("cartUrl", "/web/cart/embedded?includeButtons=true&request=" + new Date().getTime());
	reloadShoppingCart($("#SelfService-1782302045308-cartPanelInternal"));
});
	
$("#SelfService-1782302045308-cartPanel").on("panelopen", function() {	
	$("#shoppingCartProceedToCheckoutButton").focus();
});	
</script>
