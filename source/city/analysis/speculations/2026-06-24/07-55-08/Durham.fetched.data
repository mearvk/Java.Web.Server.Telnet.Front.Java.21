<!-- ChatBot Snippet (Site-level) -->
<!-- Include Lato Font from Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&display=swap" rel="stylesheet">

<!-- Botpress Webchat Embed Scripts -->
<script src="https://cdn.botpress.cloud/webchat/v2.2/inject.js"></script>
<script src="https://files.bpcontent.cloud/2025/03/14/23/20250314230531-TWLII1V6.js"></script>

<style>
  iframe.bpWebchat {
    z-index: 2147483647 !important;
  }

  #chat-launcher {
    position: fixed;
    bottom: 0;
    right: 0;
    z-index: 2147483648;
    cursor: pointer;
    display: inline-block;
    outline: none;
  }

  #chat-launcher:focus {
  outline: none;
}

#chat-launcher:focus-visible {
  outline: 2px solid #0078d7;
  outline-offset: 4px;
}


  #chat-label-images {
    position: relative;
    display: inline-block;
  }

  .chat-label {
    max-width: 125px!important;
    height: auto;
    transition: opacity 0.3s ease;
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
  }

  .chat-label.active {
    opacity: 1;
    position: relative;
  }

  /* Close Button Visibility Logic */
  .bpFab {
    display: none !important;
  }

  .bpOpen.bpWebchat + .bpFab {
    display: flex !important;
  }
</style>

<!-- Custom Chat Launcher -->
<div id="chat-launcher" tabindex="0" role="button" aria-label="Open chat">
  <div id="chat-label-images">
    <img id="label-chat" class="chat-label active" src="/Images/ChatBot-Images/chat-active---new.png?Small" alt="Let's Chat Label">
    <img id="label-charlemos" class="chat-label" src="/Images/ChatBot-Images/chat-sp.png?Small" alt="Charlemos Label">
  </div>
</div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const chatLauncher = document.getElementById('chat-launcher');
    const labelChat = document.getElementById('label-chat');
    const labelCharlemos = document.getElementById('label-charlemos');
    let labelToggle = true;

    // Alternate between images
    setInterval(() => {
      if (labelToggle) {
        labelChat.classList.remove('active');
        labelCharlemos.classList.add('active');
      } else {
        labelCharlemos.classList.remove('active');
        labelChat.classList.add('active');
      }
      labelToggle = !labelToggle;
    }, 3500);

    // Handle click
    chatLauncher.addEventListener("click", () => {
      if (window.botpress) botpress.open();
    });

    // Handle keyboard activation (Enter or Space)
    chatLauncher.addEventListener("keydown", (e) => {
      const key = e.key || e.code;
      if (key === "Enter" || key === " " || key === "Spacebar") {
        e.preventDefault();
        if (window.botpress) botpress.open();
      }
    });

    // Hide launcher when chat is open
    window.botpress.on("webchat:opened", () => {
      chatLauncher.style.display = "none";
    });

    // Show launcher again when chat is closed
    window.botpress.on("webchat:closed", () => {
      chatLauncher.style.display = "flex";
    });

    // React to visibility changes
    window.botpress.on("webchatVisibility", (state) => {
      chatLauncher.style.display = state === "visible" ? "none" : "flex";
    });

    // On load, show or hide launcher
    window.botpressWebChat.onLoad(() => {
      window.botpressWebChat.isOpen().then((isOpen) => {
        chatLauncher.style.display = isOpen ? "none" : "flex";
      });
    });

    // Fallback to show launcher after delay
    setTimeout(() => {
      chatLauncher.style.display = "flex";
    }, 5000);
  });
</script>

