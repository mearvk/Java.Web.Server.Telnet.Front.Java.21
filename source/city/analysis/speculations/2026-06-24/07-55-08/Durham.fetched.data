    <div id="topZone">
        
        <div class="TitanStripe StripeDefault"><div class="siteBounds"><div class="Freeform New100 CenterZone TitanBlock"><h2 style="text-align:center">Our Services</h2>
</div><div class="Aggregation SubService FilterGrid ThreeCard New100 CenterZone TitanBlock"><div class="ResultsListing AggregationResults" aria-live="polite" xmlns:msxsl="urn:schemas-microsoft-com:xslt"><div id="F3578_Waiting" class="loading">Please wait while we gather your results.</div><div id="F3578_ResultsDiv" class="AggregationResults"><div class="data" id="F3578_skiptoResults"><div class="OneCol"><div class="item image altRow"><a class="teaserImage" title="Online Public Records Search" href="/Register-of-Deeds/Real-Estate-Records/Online-Public-Records-Search"><img loading="lazy" alt="" src="/Images/Icons/paper.png" class="lazy animate-in"></a><div class="otherStuff"><!--content spacer--><h4 role="presentation">Online Public Records Search</h4><p class="teaser">Online database of recorded real estate and business documents.</p><p class="linkText"><a aria-label="Read More about Online Public Records Search" href="/Register-of-Deeds/Real-Estate-Records/Online-Public-Records-Search">Read More</a></p></div></div><div class="item image"><a class="teaserImage" title="Document Recording Standards" href="/Register-of-Deeds/Real-Estate-Records/Document-Recording-Standards"><img loading="lazy" alt="" src="/Images/Icons/insurance.png" class="lazy animate-in"></a><div class="otherStuff"><!--content spacer--><h4 role="presentation">Document Recording Standards</h4><p class="teaser">Documents to be recorded must meet the recording standards in accordance with N.C.G.S. 161-14 (b).</p><p class="linkText"><a aria-label="Read More about Document Recording Standards" href="/Register-of-Deeds/Real-Estate-Records/Document-Recording-Standards">Read More</a></p></div></div><div class="item image altRow"><a class="teaserImage" title="Electronic Recording Vendors" href="/Register-of-Deeds/Real-Estate-Records/Electronic-Recording-Vendors"><img loading="lazy" alt="" src="/Images/Icons/upload.png" class="lazy animate-in"></a><div class="otherStuff"><!--content spacer--><h4 role="presentation">Electronic Recording Vendors</h4><p class="teaser">Information on electronic recording vendors for businesses that prefer to electronically file documents for recording.</p><p class="linkText"><a aria-label="Read More about Electronic Recording Vendors" href="/Register-of-Deeds/Real-Estate-Records/Electronic-Recording-Vendors">Read More</a></p></div></div><div class="item image"><a class="teaserImage" title="Fee Schedule" href="/Register-of-Deeds/Real-Estate-Records/Fee-Schedule"><img loading="lazy" alt="" src="/Images/Icons/income.png" class="lazy animate-in"></a><div class="otherStuff"><!--content spacer--><h4 role="presentation">Fee Schedule</h4><p class="teaser">A listing of fees charged for recording services.</p><p class="linkText"><a aria-label="Read More about Fee Schedule" href="/Register-of-Deeds/Real-Estate-Records/Fee-Schedule">Read More</a></p></div></div><div class="item image altRow"><a class="teaserImage" title="Recording Notification Service" href="https://rodweb.dconc.gov/web/user/disclaimer"><img loading="lazy" alt="" src="/Images/Icons/personal-information.png" class="lazy animate-in"></a><div class="otherStuff"><!--content spacer--><h4 role="presentation">Recording Notification Service</h4><p class="teaser">Resource for citizens to receive email notifications when documents are recorded in their name and help avoid being a victim of property fraud.</p><p class="linkText"><a aria-label="Read More about Recording Notification Service" href="https://rodweb.dconc.gov/web/user/disclaimer">Read More</a></p></div></div></div></div></div></div><script type='text/javascript'>NWS.Modules.LoadResources(["/Views/Display/Blocks/Support/NWS.FormEditorSupport.js","/Views/Display/Blocks/Support/NWS.FilterSupport.js","/scripts/NWS.HistoryExtensions.js"], [{"func":"NWS.Block.Aggregation.ResetFieldsetState","args":[3578]}], []);</script></div></div></div><div class="TitanStripe StripeGreen"><div class="siteBounds"><div class="Freeform New100 CenterZone TitanBlock"><h2 style="text-align:center">Recording Hours</h2>

<p style="text-align:center">&nbsp;Documents may be recorded Monday - Friday | 8:30am - 4:45pm; except holidays</p>

<p style="text-align:center">&nbsp;</p>
</div></div></div>
    </div>
