<div class="widget editor pageStyles narrow" id="divEditor8e2bfcf1-ff85-452a-a4ff-8a3ef6e8baa3" data-elementqueryclasses='{"wide-narrow":"min-width:25em"}'>
	    <div class="fr-view">


        <ul><li><a href="/304/Inspection-Requirements"><strong>Building Inspection Requirements</strong></a><strong>&nbsp;-&nbsp;</strong>required inspections for Single Family Residences, Duplexes, and Townhouses.</li><li><a aria-label="Who’s my inspector today? Opens in new window" href="https://durhamnc.maps.arcgis.com/apps/webappviewer/index.html?id=a4652cb5d4ef4503bb7e50ad26a96c13" rel="noopener" target="_blank"><strong>Who&rsquo;s my inspector today?</strong></a><strong>&nbsp;</strong>This link is for Building Inspectors only. For Plumbing, Mechanical, and Electrical, please use the <a aria-label="LDO system Opens in new window" href="https://ldo4.durhamnc.gov/durhamweb/" rel="noopener" target="_blank">LDO system</a>.</li><li><a aria-label="Informal Internal Review (PDF) Opens in new window" href="https://durhamnc.gov/DocumentCenter/View/17593" rel="noopener noreferrer" target="_blank"><strong>Informal Internal Review (PDF)</strong></a><strong>&nbsp;-&nbsp;</strong>Per G.S. 160A-412 and G.S. 153A-352, a form for requesting an informal internal review of inspections decisions is available in our office or online. Please submit completed forms to the Chief or Field Supervisor of that trade. For more information on the internal review process, please call our main number at 919-560-4144.</li></ul>
    </div>

<script type="text/javascript">
	$(document).ready(function (e) {		
	    renderSlideshowIfApplicable($('#divEditor' + '8e2bfcf1-ff85-452a-a4ff-8a3ef6e8baa3'));
	});
</script>
</div>
				</div>
					</div>
	</div>
	<script type="text/javascript">
		
		$.when(window.Pages.rwdReady).done(function () {
			var tabbedWidgetID = 'divTabbedab7d7bf5-62e0-4e8e-a9bf-72cdd9c05339';
			var mediaQuerySize = 25;
			if (mediaQuerySize > 0) {
				var mediaElementQuery = '#' + tabbedWidgetID + ':media(this-min-width:' + mediaQuerySize + 'em)';
				var $tabbedWidget = $('#' + tabbedWidgetID);
				
                // Update child widget classes based on parent state
                var updateChildWidgetClasses = function (isParentWide) {
                    var liveEditEnabled = getCookieValue("enableLiveEdit") === "true";
                    if (liveEditEnabled)
                        return;

                    if (isParentWide) {
                        $tabbedWidget.find('.widget').addClass('wide').removeClass('narrow');
                        $tabbedWidget.find('[data-event-list-row="true"]').addClass('wide').removeClass('narrow');
                    } else {
                        $tabbedWidget.find('.widget').addClass('narrow').removeClass('wide');
                        $tabbedWidget.find('[data-event-list-row="true"]').addClass('narrow').removeClass('wide');
                    }
                };
				
				window.cpMedia.unregister(mediaElementQuery).register(mediaElementQuery, {
					deferSetup: false,
					setup: function () {
						var liveEditEnabled = $.cookie("enableLiveEdit") === "true";
						if (!liveEditEnabled) {
							$tabbedWidget.addClass('narrow').removeClass('wide');
							cpMedia.diag('$(element).addClass("narrow"), mediaQuery: ' + mediaElementQuery);
							$tabbedWidget.find('.tabbedWidget.cpTabs').hide().attr('aria-hidden', 'true');
							$tabbedWidget.find('.tabbedWidgetNarrow.cpTabs').show().attr('aria-hidden', 'false');
							$tabbedWidget.data("tabHeightSet", false);
							
							// Update child widget classes - parent is narrow
							updateChildWidgetClasses(false);
						}
					},
					match: function () {
						$tabbedWidget.addClass('wide').removeClass('narrow');
						cpMedia.diag('$(element).removeClass("narrow"), mediaQuery: ' + mediaElementQuery);
						$tabbedWidget.find('.tabbedWidget.cpTabs').show().attr('aria-hidden', 'false');
						$tabbedWidget.find('.tabbedWidgetNarrow.cpTabs').hide().attr('aria-hidden', 'true');

