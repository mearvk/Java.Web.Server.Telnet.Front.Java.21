</div>
<script>

$("#SelfService-1782264174984-cartPanel").on("panelcreate", function() {
	$("#SelfService-1782264174984-cartPanelInternal").data("cartUrl", "/web/cart/embedded?includeButtons=true&request=" + new Date().getTime());
	$("#SelfService-1782264174984-cartPanelInternal").css("max-height", $( window ).height() -20);
	reloadShoppingCart($("#SelfService-1782264174984-cartPanelInternal"));
});
	
$("#SelfService-1782264174984-cartPanel").on("panelbeforeopen", function() {
	$("#SelfService-1782264174984-cartPanelInternal").data("cartUrl", "/web/cart/embedded?includeButtons=true&request=" + new Date().getTime());
	reloadShoppingCart($("#SelfService-1782264174984-cartPanelInternal"));
});
	
$("#SelfService-1782264174984-cartPanel").on("panelopen", function() {	
	$("#shoppingCartProceedToCheckoutButton").focus();
});	
</script>
