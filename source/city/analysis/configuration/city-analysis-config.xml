    <search-engine>
                        
        
        <enabled>true</enabled>
                        
        
        <!-- default-engine: google | bing | duckduckgo | brave -->
                        
        
        <default-engine>duckduckgo</default-engine>
                        
        
        <!-- Google Custom Search JSON API key — https://developers.google.com/custom-search/v1/overview -->
                        
        
        <api-key>YOUR_API_KEY_HERE</api-key>
                        
        
        <!-- Google Custom Search Engine ID (cx) — https://programmablesearchengine.google.com/ -->
                        
        
        <cx>YOUR_CX_HERE</cx>
                        
        
        <max-results>10</max-results>
                        
        
        <!-- Alternative engines:
             google      — Google Custom Search JSON API (requires api-key + cx)
             bing        — Bing Web Search API v7 (requires api-key as Ocp-Apim-Subscription-Key)
             duckduckgo  — DuckDuckGo Instant Answer API (no key, limited results)
             brave       — Brave Search API (requires api-key as X-Subscription-Token)
        -->
                        
        
        <queries>
                                    
            
            <query>%CITY% %STATE% real estate market trends</query>
                                    
            
            <query>%CITY% %COUNTY% county lending practices mortgage</query>
                                    
            
            <query>%CITY% %STATE% property values deed records</query>
                                    
            
            <query>%CITY% %STATE% foreclosure rates housing market</query>
                                    
            
            <query>%CITY% %COUNTY% county real estate investment</query>
                                
        
        </queries>
                        
        
        <add-discovered-urls-to-sources>true</add-discovered-urls-to-sources>
                    
    
    </search-engine>

    <!-- ROD Search Configuration — Durham County Register of Deeds DOCSEARCH5S1 -->
    <rod-search-config>
        <base-url>https://rodweb.dconc.gov</base-url>
        <search-url>/web/search/DOCSEARCH5S1</search-url>
        <document-url-pattern>/web/document/DOC{id}S{step}?search=DOCSEARCH5S1</document-url-pattern>

        <!-- Search type selectors (buttons on the ROD form) -->
        <search-types>
            <type id="human" default="true">Exact name match</type>
            <type id="soundex">Phonetic/soundex name match</type>
        </search-types>

        <!-- Document groups available on DOCSEARCH5S1 -->
        <document-groups>
            <group id="deeds">Deeds</group>
            <group id="mortgages">Mortgages</group>
            <group id="liens">Liens</group>
            <group id="plats">Plats</group>
            <group id="maps">Maps</group>
            <group id="corporate">Corporate Books</group>
            <group id="condo">Condo Books</group>
            <group id="all" default="true">All Document Types</group>
        </document-groups>

        <!-- Fields extracted from document detail pages -->
        <result-fields>
            <field>BOOK_TYPE</field>
            <field>BOOK</field>
            <field>PAGE</field>
            <field>RECORDED_DATE</field>
            <field>FILED_DATE</field>
            <field>DOCUMENT_TYPE</field>
            <field>GRANTORS</field>
            <field>GRANTEES</field>
            <field>LEGAL_DESCRIPTION</field>
        </result-fields>

        <!-- Query strategy: parcel first, then name, with soundex fallback -->
        <query-strategy>
            <primary>parcel-id</primary>
            <secondary>name-human</secondary>
            <fallback>name-soundex</fallback>
        </query-strategy>

        <!-- Known common names to search (owners from local property records) -->
        <known-names>
            <name lastName="RUPPLIN" firstName=""/>
            <name lastName="DUKE" firstName=""/>
            <name lastName="DURHAM" firstName=""/>
        </known-names>

        <!-- Output -->
        <output-csv>source/city/analysis/data/durham.nc.rod.query.results.csv</output-csv>
        <test-csv>source/city/analysis/data/durham.nc.rod.test.100.results.csv</test-csv>

        <!-- Rate limiting -->
        <delay-between-requests-ms>3000</delay-between-requests-ms>
        <max-document-follows-per-search>25</max-document-follows-per-search>
    </rod-search-config>
            
    
    <connection>
                        
        
        <timeout-ms>15000</timeout-ms>
                        
        
        <retry-count>3</retry-count>
                        
        
        <user-agent>NitroWebExpress/CityAnalysis 1.0</user-agent>
                    
    
    </connection>
            
    
    <input-mode>
                        
        
        <!-- file | crawl -->
                        
        
        <default>file</default>
                        
        
        <crawl-options>
                                    
            
            <store-raw>true</store-raw>
                                    
            
            <raw-dir>source/city/analysis/raw/</raw-dir>
                                    
            
            <follow-links>true</follow-links>
                                    
            
            <max-depth>3</max-depth>
                                    
            
            <max-pages>50</max-pages>
                                    
            
            <accepted-types>html,xml,csv</accepted-types>
                                    
            
            <delay-between-requests-ms>2000</delay-between-requests-ms>
                                
        
        </crawl-options>
                    
    
    </input-mode>
            
    
