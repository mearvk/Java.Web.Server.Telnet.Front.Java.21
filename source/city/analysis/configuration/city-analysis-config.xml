    <search-engine>
                        
        
        <enabled>true</enabled>
                        
        
        <!-- default-engine: google | bing | duckduckgo | brave -->
                        
        
        <default-engine>duckduckgo</default-engine>
                        
        
        <!-- Google Custom Search JSON API key — https://developers.google.com/custom-search/v1/overview -->
                        
        
        <api-key>YOUR_API_KEY_HERE</api-key>
                        
        
        <!-- Google Custom Search Engine ID (cx) — https://programmablesearchengine.google.com/ -->
                        
        
        <cx>YOUR_CX_HERE</cx>
                        
        
        <max-results>10</max-results>
                        
        
        <!-- Alternative engines:
             google      — Google Custom Search JSON API (requires api-key + cx)
             bing        — Bing Web Search API v7 (requires api-key as Ocp-Apim-Subscription-Key)
             duckduckgo  — DuckDuckGo Instant Answer API (no key, limited results)
             brave       — Brave Search API (requires api-key as X-Subscription-Token)
        -->
                        
        
        <queries>
                                    
            
            <query>%CITY% %STATE% real estate market trends</query>
                                    
            
            <query>%CITY% %COUNTY% county lending practices mortgage</query>
                                    
            
            <query>%CITY% %STATE% property values deed records</query>
                                    
            
            <query>%CITY% %STATE% foreclosure rates housing market</query>
                                    
            
            <query>%CITY% %COUNTY% county real estate investment</query>
                                
        
        </queries>
                        
        
        <add-discovered-urls-to-sources>true</add-discovered-urls-to-sources>
                    
    
    </search-engine>
            
    
    <connection>
                        
        
        <timeout-ms>15000</timeout-ms>
                        
        
        <retry-count>3</retry-count>
                        
        
        <user-agent>NitroWebExpress/CityAnalysis 1.0</user-agent>
                    
    
    </connection>
            
    
    <input-mode>
                        
        
        <!-- file | crawl -->
                        
        
        <default>file</default>
                        
        
        <crawl-options>
                                    
            
            <store-raw>true</store-raw>
                                    
            
            <raw-dir>source/city/analysis/raw/</raw-dir>
                                    
            
            <follow-links>true</follow-links>
                                    
            
            <max-depth>3</max-depth>
                                    
            
            <max-pages>50</max-pages>
                                    
            
            <accepted-types>html,xml,csv</accepted-types>
                                    
            
            <delay-between-requests-ms>2000</delay-between-requests-ms>
                                
        
        </crawl-options>
                    
    
    </input-mode>
            
    
