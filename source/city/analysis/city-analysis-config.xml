    <input-mode>
        <!-- file | crawl -->
        <default>file</default>
        <crawl-options>
            <store-raw>true</store-raw>
            <raw-dir>source/city/analysis/raw/</raw-dir>
            <follow-links>true</follow-links>
            <max-depth>3</max-depth>
            <max-pages>50</max-pages>
            <accepted-types>html,xml,csv</accepted-types>
            <delay-between-requests-ms>2000</delay-between-requests-ms>
        </crawl-options>
    </input-mode>

